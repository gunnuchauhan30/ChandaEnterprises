# ============================================
# CHANDA FRONTEND ENVIRONMENT CONFIGURATION
# ============================================

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=CHANGE_ME_run_python3_-c_"import secrets;print(secrets.token_hex(32))"

# Backend API Configuration
# Docker network ke andar backend service ka naam use hota hai (docker-compose.yml me override bhi hai)
BACKEND_URL=http://backend:8000

# CORS Configuration
# Apna real production domain daalein, e.g. https://chanda-enterprises.com
CORS_ORIGINS=http://localhost:5000

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/frontend.log

# Security
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_MINUTES=1440

# Feature Flags
ENABLE_EXPORT=True
ENABLE_IMPORT=True
ENABLE_REPORTS=True
ENABLE_ALERTS=True
