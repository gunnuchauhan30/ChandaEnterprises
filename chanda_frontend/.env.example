# ============================================
# CHANDA FRONTEND ENVIRONMENT CONFIGURATION
# ============================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-use-random-64-chars

# Backend API Configuration
BACKEND_URL=http://localhost:8000

# CORS Configuration
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Database (if frontend needs direct DB access, which it typically doesn't)
# DATABASE_URL=postgresql://user:password@localhost:5432/chanda_store

# Email Configuration (optional, for backend communication)
# EMAIL_ENABLED=False
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@chanda-enterprises.com
# SMTP_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/frontend.log

# Security
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_MINUTES=1440

# Feature Flags
ENABLE_EXPORT=True
ENABLE_IMPORT=True
ENABLE_REPORTS=True
ENABLE_ALERTS=True
