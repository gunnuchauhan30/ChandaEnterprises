# Copy this file to .env and fill in real values before running in production.
#
# PRODUCTION CHECKLIST (do not skip):
#   1. ENV=production and DEBUG=False  -> disables Swagger/Redoc docs and
#      stops stack traces leaking to clients.
#   2. Generate a real JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#   3. Fill real DATABASE_URL, SMTP_* creds, and set EMAIL_ENABLED=True.
#   4. Set CORS_ORIGINS to your actual frontend domain(s) only -- never "*".

ENV=development
DEBUG=True

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chanda_store

JWT_SECRET_KEY=change-this-to-a-long-random-string-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

LOW_STOCK_DEFAULT=1500
HIGH_STOCK_DEFAULT=5000

# SMTP (leave EMAIL_ENABLED=False until these are filled with real credentials)
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@chandaenterprises.com
SMTP_FROM_NAME=Chanda Enterprises - Store System
SMTP_USE_TLS=True

ADMIN_ALERT_EMAILS=[]
STORE_MANAGER_ALERT_EMAILS=[]
PURCHASE_DEPT_ALERT_EMAILS=[]

UPLOAD_DIR=uploads/invoices
MAX_UPLOAD_MB=10
